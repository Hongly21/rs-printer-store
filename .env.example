# ==========================================
# RS Printer - Telegram Bot & Group Settings
# ==========================================

# 1. Obtain your Bot Token from @BotFather on Telegram:
#    - Open Telegram, chat with @BotFather, type /newbot
#    - Copy the HTTP API token given to you
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# 2. Telegram Group Chat ID:
#    - Create your Telegram shop group (e.g., "RS Printer Orders")
#    - Add your Bot to the group and give it Admin privileges
#    - Forward a message from the group to @userinfobot or @getmyid_bot to get the Group Chat ID
#    - Group chat IDs usually start with a minus sign and -100 (e.g., -1001234567890)
TELEGRAM_GROUP_CHAT_ID="-100xxxxxxxxxx"
